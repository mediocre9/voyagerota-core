[Unit]
Description=VoyagerOTA API
After=network-online.target mariadb.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=voyager
Group=voyager
WorkingDirectory=/opt/voyagerota/core
EnvironmentFile=/opt/voyagerota/core/.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=192
ExecStart=/usr/bin/node --import tsx src/server.ts
Restart=always
RestartSec=5
# a leak in one service can't take the whole droplet down....
MemoryHigh=280M
MemoryMax=320M
StandardOutput=journal
StandardError=journal
SyslogIdentifier=voyager-api

[Install]
WantedBy=multi-user.target
