# voyagerota-core production settings, copied to /opt/voyagerota/core/.env by deploy/setup.sh
# Values marked GENERATED are filled in by setup.sh. Never commit the real file.

# Server
PORT=8080
BASE_URL=https://api.voyagerota.com
ENVIRONMENT=production

# Browser origins allowed to call the API, comma separated
CORS_ORIGIN=https://app.voyagerota.com

# Dashboard address used in email links
APP_URL=https://app.voyagerota.com

# Database (MariaDB on this droplet)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=voyagerota
DB_USERNAME=voyagerota
DB_PASSWORD=GENERATED

# Clerk production instance (live keys)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Brevo email
BREVO_SMTP_API_KEY=
BREVO_SMTP_SENDER_NAME=VoyagerOTA
BREVO_SMTP_SENDER_EMAIL=no-reply@voyagerota.com
# Where service alerts (database or redis restarted) go
BREVO_SMTP_RECEPIENT_DEV_EMAIL=
# Optional: replies to emails go here, and "Get help" links to it (GitHub issues when empty)
SUPPORT_EMAIL=

# Signs the "Keep this project" links in emails
KEEP_LINK_SECRET=GENERATED
# true: the cleanup crons only log what they would do
DORMANT_DRY_RUN=false

# Firmware storage on Cloudflare R2 (token with Object Read & Write on the firmware bucket)
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=voyager-firmware

# Nightly database backups, read by deploy/backup.sh (token for the backups bucket only)
BACKUP_R2_BUCKET=voyager-backups
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_KEEP_DAYS=14

# Telemetry broker, not used yet
MQTT_ADDRESS=
MQTT_PORT=
MQTT_CLIENT=
MQTT_USERNAME=
MQTT_PASSWORD=
BROKER_BASE_URL=
BROKER_BASIC_AUTH_CREDENTIALS=
