# Server
PORT=8080
BASE_URL=http://localhost
ENVIRONMENT=development

# Database (MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=voyagerota
DB_USERNAME=root
DB_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MQTT (Telemetry)
MQTT_ADDRESS=mqtt://localhost
MQTT_PORT=1883
MQTT_CLIENT=voyagerota
MQTT_USERNAME=
MQTT_PASSWORD=

# Broker (EMQX etc)
BROKER_BASE_URL=http://localhost:8083
BROKER_BASIC_AUTH_CREDENTIALS=base64(creds)

# Brevo (Email)
BREVO_SMTP_API_KEY=
BREVO_SMTP_SENDER_NAME=VoyagerOTA
BREVO_SMTP_SENDER_EMAIL=no-reply@example.com
BREVO_SMTP_RECEPIENT_DEV_EMAIL=dev@example.com

# Clerk (dashboard authentication for voyagerota-web)
# Required in production. In development the dashboard APIs answer 401 without it.
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Dormant projects
# Dashboard address used in emails, e.g. https://app.example.com
APP_URL=http://localhost:5173
# Signs the "Keep this project" links in emails
KEEP_LINK_SECRET=change-me
# true: the cleanup crons only log what they would do
DORMANT_DRY_RUN=false
# development only: a "day" lasts a second so the whole cleanup runs in under 2 minutes
DORMANT_FAST_TEST=false
