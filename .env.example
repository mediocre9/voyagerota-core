# Server
PORT=8080
SESSION_SECRET=change-me
BASE_URL=http://localhost
ENVIRONMENT=development

# Database (MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=voyagerota
DB_USERNAME=root
DB_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# MQTT (Telemetry)
MQTT_ADDRESS=mqtt://localhost
MQTT_PORT=1883
MQTT_CLIENT=voyagerota
MQTT_USERNAME=
MQTT_PASSWORD=

# Broker (EMQX etc)
BROKER_BASE_URL=http://localhost:8083
BROKER_BASIC_AUTH_CREDENTIALS=base64(creds)

# Brevo (Email)
BREVO_SMTP_API_KEY=
BREVO_SMTP_SENDER_NAME=VoyagerOTA
BREVO_SMTP_SENDER_EMAIL=no-reply@example.com
BREVO_SMTP_RECEPIENT_DEV_EMAIL=dev@example.com

# Google OAuth
# Option 1: provide oauth-client-secret.json (gitignored) at the voyagerota-core root.
# Option 2: set the env vars below. Values from the JSON file take precedence.
# If none are configured, OAuth login is disabled in development; production fails fast.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI_DEV=http://localhost:8080/auth/google/callback
GOOGLE_REDIRECT_URI_PROD=https://yourdomain.com/auth/google/callback
